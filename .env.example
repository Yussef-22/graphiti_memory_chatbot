APP_NAME=Graphiti Memory Chatbot
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=graphiti_memory
FALKORDB_CONNECT_TIMEOUT=3.0

# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Keep Graphiti concurrency low while using Gemini's free tier.
SEMAPHORE_LIMIT=1
MEMORY_SEARCH_LIMIT=5
CHAT_MAX_OUTPUT_TOKENS=1024
GRAPHITI_TELEMETRY_ENABLED=false
